# PostgreSQL connection string. URL-encode reserved characters in the password.
DATABASE_URL=postgresql://<username>:<password>@<render-host>:5432/<database>?sslmode=require

# Generate a random secret with at least 32 characters.
AUTH_SECRET=<generate-a-strong-random-secret>

# Optional. Keep this server-side; it is never sent to the browser.
GEMINI_API_KEY=<your-gemini-api-key>

# Optional override; Render URLs with sslmode=require enable SSL automatically.
# SQL_SSL=true

# Optional server port (defaults to 3000).
# PORT=3000

# Optional Firebase Admin credentials for Google SSO on non-GCP hosts such as Render.
# FIREBASE_CLIENT_EMAIL=<service-account-client-email>
# FIREBASE_PRIVATE_KEY=<service-account-private-key-with-escaped-newlines>
